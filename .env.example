# Postgres connection string (Neon-backed). When you add the Neon storage
# integration in the Vercel dashboard, it's injected as DATABASE_URL — the app
# accepts that name automatically, so you can paste the pooled connection
# string from Neon's dashboard (Storage -> your Neon project -> Quickstart ->
# .env.local tab -> DATABASE_URL) under either key below.
POSTGRES_URL="postgres://user:password@host/dbname?sslmode=require"
# DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Random secret used to sign session JWTs (HS256). Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
