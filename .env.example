# Postgres connection string (Neon-backed). When you add the Vercel Postgres /
# Neon storage integration in the Vercel dashboard, this is injected automatically.
# For local dev, create a free Neon project at https://neon.tech and paste its
# connection string here.
POSTGRES_URL="postgres://user:password@host/dbname?sslmode=require"

# Random secret used to sign session JWTs (HS256). Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
